{
  "compilerOptions": {
    "target": "es6",
    "module": "Node16",
    "lib": ["es6", "dom"],
    "types": ["cypress", "node"],
    "moduleResolution": "Node16",
    "strict": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["cypress/**/*.ts", "cypress.config.ts", "*.d.ts"]
}